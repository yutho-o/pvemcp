{
  "default": "lab",
  "instances": {
    "lab": {
      "url": "https://10.0.0.10:8006",
      "token": "${PVE_LAB_TOKEN}",
      "fingerprint": "${PVE_LAB_FINGERPRINT}",
      "allow_writes": true,
      "allow_ssh": true,
      "default_node": "pve1",
      "local_dir": "${PVE_LAB_LOCAL_DIR}",
      "description": "Cluster de test : écritures et SSH",
      "ssh": {
        "key_file": "${PVE_LAB_SSH_KEY_FILE}",
        "nodes": { "pve1": "10.0.0.11", "pve2": "10.0.0.12" },
        "fingerprints": { "pve1": "${PVE1_HOST_KEY}" },
        "host_key_policy": "strict",
        "timeout_seconds": 120
      }
    },
    "prod": {
      "url": "https://pve.example.com:8006",
      "token_id": "mcp@pve!pvemcp",
      "token_secret": "${PVE_PROD_TOKEN_SECRET}",
      "verify_ssl": true,
      "allow_writes": false,
      "dry_run": true,
      "protected_vmids": [100, 101],
      "description": "Production : aperçus seulement"
    }
  }
}
