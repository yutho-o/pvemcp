{
  "name": "pvemcp",
  "version": "0.1.0",
  "description": "Serveur MCP pour Proxmox VE : couverture totale de l'API, gestion SSH et LXC, lecture seule par défaut.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pvemcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "catalog": "node scripts/build-catalog.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ssh2": "~1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
